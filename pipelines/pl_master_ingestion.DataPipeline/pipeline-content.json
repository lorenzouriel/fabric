{
  "properties": {
    "description": "Metadata-driven ingestion into lh_senado_bronze. Reads etl_ingestion_config, then runs one notebook per source (in parallel). Each source notebook runs its due datasets in order with a shared rate limit, logs every dataset to etl_execution_log, and refreshes etl_dataset_status.",
    "parameters": {
      "mode": {
        "type": "string",
        "defaultValue": "incremental"
      },
      "source_system": {
        "type": "string",
        "defaultValue": ""
      },
      "entity": {
        "type": "string",
        "defaultValue": ""
      },
      "backfill_start": {
        "type": "string",
        "defaultValue": ""
      },
      "backfill_end": {
        "type": "string",
        "defaultValue": ""
      },
      "force": {
        "type": "string",
        "defaultValue": "false"
      },
      "key_vault_url": {
        "type": "string",
        "defaultValue": ""
      }
    },
    "activities": [
      {
        "name": "Read Ingestion Metadata",
        "type": "TridentNotebook",
        "dependsOn": [],
        "policy": {
          "timeout": "0.00:30:00",
          "retry": 2,
          "retryIntervalInSeconds": 120,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "c93b070c-aeab-4c54-b7c3-e927233c57ce",
          "workspaceId": "00000000-0000-0000-0000-000000000000",
          "sessionTag": "senado360_ingestion",
          "parameters": {
            "source_system": {
              "value": {
                "value": "@pipeline().parameters.source_system",
                "type": "Expression"
              },
              "type": "string"
            },
            "entity": {
              "value": {
                "value": "@pipeline().parameters.entity",
                "type": "Expression"
              },
              "type": "string"
            }
          }
        },
        "description": "Returns the sources with enabled datasets in etl_ingestion_config."
      },
      {
        "name": "Log Metadata Failure",
        "type": "TridentNotebook",
        "dependsOn": [
          {
            "activity": "Read Ingestion Metadata",
            "dependencyConditions": [
              "Failed"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:30:00",
          "retry": 2,
          "retryIntervalInSeconds": 120,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "notebookId": "f3f468e1-03e5-4840-a694-8265ea20fb19",
          "workspaceId": "00000000-0000-0000-0000-000000000000",
          "sessionTag": "senado360_ingestion",
          "parameters": {
            "pipeline_name": {
              "value": {
                "value": "@pipeline().Pipeline",
                "type": "Expression"
              },
              "type": "string"
            },
            "pipeline_run_id": {
              "value": {
                "value": "@pipeline().RunId",
                "type": "Expression"
              },
              "type": "string"
            },
            "mode": {
              "value": {
                "value": "@pipeline().parameters.mode",
                "type": "Expression"
              },
              "type": "string"
            },
            "activity_name": {
              "value": {
                "value": "@string('Read Ingestion Metadata')",
                "type": "Expression"
              },
              "type": "string"
            },
            "error_message": {
              "value": {
                "value": "@string(activity('Read Ingestion Metadata').error.message)",
                "type": "Expression"
              },
              "type": "string"
            }
          }
        },
        "description": "Logs FAILED for datasets 'Read Ingestion Metadata' could not log itself, and refreshes their status."
      },
      {
        "name": "Rethrow Metadata Failure",
        "type": "Fail",
        "description": "Re-raises the original error so the run is marked Failed (a handler alone would mark it Succeeded).",
        "dependsOn": [
          {
            "activity": "Log Metadata Failure",
            "dependencyConditions": [
              "Completed"
            ]
          }
        ],
        "typeProperties": {
          "message": {
            "value": "@string(activity('Read Ingestion Metadata').error.message)",
            "type": "Expression"
          },
          "errorCode": "INGESTION_FAILED"
        }
      },
      {
        "name": "ForEach Source",
        "description": "One iteration per source; sources run in parallel, datasets inside a source run in order.",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "Read Ingestion Metadata",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@json(activity('Read Ingestion Metadata').output.result.exitValue)",
            "type": "Expression"
          },
          "isSequential": false,
          "batchCount": 4,
          "activities": [
            {
              "name": "Route By Source",
              "type": "Switch",
              "dependsOn": [],
              "typeProperties": {
                "on": {
                  "value": "@item().source_system",
                  "type": "Expression"
                },
                "cases": [
                  {
                    "value": "senado_legislativo",
                    "activities": [
                      {
                        "name": "Ingest Senado Legislativo",
                        "type": "TridentNotebook",
